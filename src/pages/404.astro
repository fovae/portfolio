---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base title="Not found | Fovae">
  <section class="case-hero">
    <div class="wrap">
      <span class="kicker">ERROR 404</span>
      <h1 class="case-title">Signal lost</h1>
      <p class="case-sum">This page does not exist.</p>
      <div class="cta-row" style="margin-top:20px"><a class="btn primary" href={url('/')}>Back home</a></div>
    </div>
  </section>
</Base>
