---
import { icons, type IconName } from '../data/icons';
interface Props { name: IconName; }
const { name } = Astro.props;
// outline-style glyphs drawn with holes need even-odd filling
const evenodd = name === 'mail';
---
<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={icons[name]} fill-rule={evenodd ? 'evenodd' : undefined} /></svg>
