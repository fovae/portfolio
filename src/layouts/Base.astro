---
import { url } from '../lib/url';
// Latin-only variable fonts, self-hosted and preloaded (the full fontsource CSS ships 5 subsets).
import sgFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jbFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/base.css';
import '../styles/hud.css';
import '../styles/sections.css';
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string; }
const { title = site.title, description = site.description, image = url('/og-image.jpg') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, url: string, weight: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2-variations');unicode-range:${LATIN}}`;
const fontFaces = face('Space Grotesk Variable', sgFont, '300 700') + face('JetBrains Mono Variable', jbFont, '100 800');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/icons/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={url('/icons/favicon-16.png')} sizes="16x16" type="image/png" />
    <link rel="icon" href={url('/icons/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />

    <link rel="preload" href={sgFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <!-- Content is hidden for the reveal animation only when JS is running. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Background />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
